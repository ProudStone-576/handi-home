{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    { "source": "/(media|assets)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)\\.(svg|png|jpg|webp|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
